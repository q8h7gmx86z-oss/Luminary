{
  "expo": {
    "name": "Luminary",
    "slug": "luminary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mimiriosgroup.luminary"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1640",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mimiriosgroup.luminary"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "luminary",
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#0B1640"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "mimi-rios-group-ltd",
    "extra": {
      "eas": {
        "projectId": "b6fc3b6a-02c3-468c-aeec-ce586c05ecbe"
      },
      "auraEndpoint": "",
      "auraKey": ""
    }
  }
}
